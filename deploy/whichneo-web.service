[Unit]
Description=WhichNEO observer website (L01 Tican)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/devanshi-s04/visnjan_whichneo
# Flask's dev server is single-threaded; use a real WSGI server in production:
#   pip install waitress && ExecStart=python3 -m waitress --port=5000 app:app
ExecStart=/usr/bin/env python3 app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
